# Copy to .env.local and fill in. Never commit secrets.
# Required env vars are documented per docs/ARCHITECTURE.md §2.4.

# --- Supabase (auth + Postgres) ---
# Project URL — public, exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Anon key — public, exposed to the client. Row-level security enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never ship to the client. Used in server actions
# and admin routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (model artifacts + reference videos) ---
# Public-read bucket URL (worker route or r2.dev URL). Used by the client to
# fetch model artifacts and reference videos.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
# Private R2 access for server-side training pipeline uploads. Never client-side.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MODELS=asl-mastery-models
R2_BUCKET_REFERENCES=asl-mastery-references
R2_BUCKET_RAW_TRAINING_DATA=asl-mastery-raw-training-data

# --- Sentry (errors) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- PostHog (product analytics, configured to never receive video data) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- OpenAI (server-side TTS for the practice avatar box) ---
# SERVER ONLY — read by app/api/tts/route.ts, never exposed to the client.
# Put the real key in .env.local (gitignored), not here. On Vercel, set it as a
# Project Environment Variable. If unset, TTS is silently disabled.
OPENAI_API_KEY=

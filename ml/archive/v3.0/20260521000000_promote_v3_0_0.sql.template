-- it inserts the v3.0.0 row + sets is_active=true, atomically. The
-- partial unique index `model_versions_one_active` (from
-- 20260519100000_init.sql) ensures only one row carries is_active=true.

-- 1. Insert the v3.0.0 row with the artifact URLs.
insert into public.model_versions (id, artifact_url, config_url, metrics_url, is_active, promoted_at)
values (
  'v3.0.0',
  'https://<R2_PUBLIC_BASE>/v3.0.0/classifier.onnx',
  'https://<R2_PUBLIC_BASE>/v3.0.0/config.json',
  'https://<R2_PUBLIC_BASE>/v3.0.0/validation.json',
  true,
  now()
)
on conflict (id) do update
  set artifact_url = excluded.artifact_url,
      config_url   = excluded.config_url,
      metrics_url  = excluded.metrics_url,
      is_active    = true,
      promoted_at  = excluded.promoted_at;

-- 2. Flip every other row to is_active=false. Idempotent.
update public.model_versions set is_active = false where id <> 'v3.0.0';

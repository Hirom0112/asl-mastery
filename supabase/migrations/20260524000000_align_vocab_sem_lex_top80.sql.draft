-- Align the practice sidebar (vocabulary_items) to the TRAINING vocab
-- (dataset/sem_lex_top80_vocabulary.json — the 80 top-sem_lex words).
--
-- WHY .draft / NOT auto-applied: 54 of these 80 signs are NEW to the DB
-- (old table = slice1b: again/mom/dad/know/...). Activating them WITHOUT
-- reference videos + avatar templates + confusion hints would surface words
-- whose practice screen is broken. Apply ONLY after those assets exist for
-- the new signs, or this just makes the LIST match (sidebar) while practice
-- assets lag. Sidebar order = sem_lex clip count desc (most-trained first).
--
-- Apply: mv ...sql.draft ...sql && supabase db push  (or run in SQL editor)

-- 1) deactivate everything, then (2) upsert+activate the 80 training signs.
update public.vocabulary_items set is_active_for_practice = false;

insert into public.vocabulary_items (id, display_gloss, category, static_or_movement, flippable, difficulty_rank, is_active_for_practice, wlasl_clip_count) values ('eat', 'EAT', 'sem_lex_top80', 'movement', false, 1, true, 597) on conflict (id) do update set is_active_for_practice = true, difficulty_rank = excluded.difficulty_rank, display_gloss = excluded.display_gloss;

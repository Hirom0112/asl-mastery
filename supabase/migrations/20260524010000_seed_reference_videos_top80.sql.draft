-- Seed reference videos for the 55 sem_lex_top80 signs that had none.
-- Source: Sem-Lex medoid clip per sign (the same canonical clip the avatar
-- template plays back), picked by scripts/pick_reference_clips.py from
-- data/trajectories_top80_v2 and recorded in dataset/reference_picks_top80.json.
-- Clips uploaded to R2 bucket asl-mastery-references at key v2/<sign>.webm.
-- License: Sem-Lex CC BY-NC-SA 4.0 (Kezar et al. 2023, arXiv:2310.00196).
-- Format: .webm (VP8), 640x480. The other 25 top80 signs already have a v2
-- reference video (20260520170000_swap_to_sem_lex_references.sql) and are left
-- untouched. Run AFTER 20260524000000_align_vocab_sem_lex_top80.sql (rows must exist).
--
-- Apply: mv ...sql.draft ...sql && supabase db push


update public.vocabulary_items set reference_video_url = 'https://pub-58faaa60e7794818b22f1158e2e9d235.r2.dev/v2/animal.webm' where id = 'animal';

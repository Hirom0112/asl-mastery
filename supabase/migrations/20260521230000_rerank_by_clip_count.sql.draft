  when 'understand' then 22  -- n_clips=96
  when 'feel' then 23  -- n_clips=92
  when 'book' then 24  -- n_clips=90
  when 'white' then 25  -- n_clips=88
  when 'black' then 26  -- n_clips=86
  when 'yellow' then 27  -- n_clips=84
  when 'small' then 28  -- n_clips=84
  when 'green' then 29  -- n_clips=83
  when 'night' then 30  -- n_clips=81
  when 'man' then 31  -- n_clips=76
  when 'dog' then 32  -- n_clips=76
  when 'milk' then 33  -- n_clips=71
  when 'know' then 34  -- n_clips=69
  when 'need' then 35  -- n_clips=68
  when 'want' then 36  -- n_clips=68
  when 'day' then 37  -- n_clips=68
  when 'name' then 38  -- n_clips=67
  when 'morning' then 39  -- n_clips=66
  when 'who' then 40  -- n_clips=62
  when 'again' then 41  -- n_clips=60
  when 'home' then 42  -- n_clips=60
  when 'teacher' then 43  -- n_clips=58
  when 'apple' then 44  -- n_clips=56
  when 'fish' then 45  -- n_clips=56
  when 'no' then 46  -- n_clips=52
  when 'hearing' then 47  -- n_clips=52
  when 'week' then 48  -- n_clips=50
  when 'angry' then 49  -- n_clips=48
  when 'meet' then 50  -- n_clips=47
  when 'now' then 51  -- n_clips=47
  when 'student' then 52  -- n_clips=40
  when 'my' then 53  -- n_clips=37
  when 'cat' then 54  -- n_clips=37
  when 'go' then 55  -- n_clips=36
  when 'tomorrow' then 56  -- n_clips=36
  when 'grandma' then 57  -- n_clips=33
  when 'sorry' then 58  -- n_clips=32
  when 'bathroom' then 59  -- n_clips=32
  when 'mom' then 60  -- n_clips=30
  when 'your' then 61  -- n_clips=28
  when 'think' then 62  -- n_clips=27
  when 'dad' then 63  -- n_clips=25
  when 'have' then 64  -- n_clips=23
  when 'brother' then 65  -- n_clips=21

-- Re-order vocabulary_items.difficulty_rank by trajectory clip count (desc).
--
-- The sidebar progression in lib/scheduler/vocab-progression.ts orders signs
-- by difficulty_rank ascending and gates "current" / "locked" off that order.
-- Re-ranking by clip count surfaces the signs the matcher has the most
-- evidence for first — i.e. the easiest to recognize land at the top, the
-- weakest at the bottom, matching the durable user preference recorded in
-- HANDOFF.md ("sorted by clip count, most-trained-first").
--
-- Source: data/sign_clip_counts.json (generated from
-- data/templates_v6/_fit_summary.json). When templates_v7 lands, re-run
-- the generator and regenerate this migration.
--
-- NOT EXECUTED. Apply with:
--   mv ...sql.draft ...sql && supabase db push
-- ...or run the body manually in the Supabase SQL editor.

update public.vocabulary_items set difficulty_rank = case id
  when 'water' then 1  -- n_clips=304
  when 'work' then 2  -- n_clips=228
  when 'car' then 3  -- n_clips=195
  when 'school' then 4  -- n_clips=171
  when 'hurt' then 5  -- n_clips=168
  when 'cold' then 6  -- n_clips=168
  when 'hot' then 7  -- n_clips=150
  when 'family' then 8  -- n_clips=148
  when 'baby' then 9  -- n_clips=148
  when 'sad' then 10  -- n_clips=140
  when 'play' then 11  -- n_clips=137
  when 'drink' then 12  -- n_clips=132
  when 'learn' then 13  -- n_clips=130
  when 'nice' then 14  -- n_clips=126
  when 'people' then 15  -- n_clips=123
  when 'red' then 16  -- n_clips=115
